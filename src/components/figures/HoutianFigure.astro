---
// Week 7 — the Houtian ("Later Heaven") directional arrangement, grounded
// in the Shuogua zhuan's trigram-direction correlations (week 4). Positions
// are externally verified against the Shuogua zhuan itself (ch. 5),
// Wilhelm/Baynes (Shuo Kua §5, Fig. 2), and Legge (Yî King, App. V and the
// introduction's comparison table) — see docs/design-decisions.md's
// Xiantian/Houtian verification note.
//
// Same south-up orientation and physical frame as XiantianFigure.astro,
// deliberately, so the two can be compared directly — but this figure
// omits Xiantian's opposite-pair connector lines. Houtian's spatial
// opposites (Li/Kan, Kun/Gen, Dui/Zhen, Qian/Xun) are not the week-5
// line-inverse pairs (only Li/Kan coincidentally is; see
// spec/arrangements.test.ts), and echoing Xiantian's visual treatment here
// would suggest otherwise. The faint circle (`.ring-guide`) is the one
// piece of visual treatment intentionally shared with XiantianFigure.astro
// (identical geometry/markup/CSS) — it is a purely spatial scaffold showing
// the eight positions sit on one circle, aria-hidden, with no direction,
// cycle, or trigram relationship implied.
import LineStack from "./LineStack.astro";
import { HOUTIAN_ARRANGEMENT, type CompassPosition } from "../../lib/arrangements";
import { trigramInfo, type TrigramName } from "../../lib/trigrams";

const nodes = HOUTIAN_ARRANGEMENT.map(({ trigram, position }) => ({
  ...trigramInfo(trigram),
  position,
}));

const gridArea = (position: CompassPosition) => position.toLowerCase();

// Only the correlations week 7's own text states. Dui's "midautumn" is the
// Shuogua zhuan's own season-word (ch. 5); Li/summer and Kan/winter are
// Wilhelm's diagram/commentary schematization of that same chapter, not a
// bare Shuogua clause — both are fine to show, but no season is invented
// for the other five trigrams, since the source doesn't give one.
const correlations: { trigram: TrigramName; note: string }[] = [
  { trigram: "Li", note: "summer" },
  { trigram: "Kan", note: "winter" },
  { trigram: "Dui", note: "midautumn" },
];
---

<figure class="fig fig-arrangement">
  <div class="arrangement-frame">
    <span class="axis-label axis-top">South</span>
    <span class="axis-label axis-bottom">North</span>
    <span class="axis-label axis-left">East</span>
    <span class="axis-label axis-right">West</span>
    <svg class="ring-guide" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
      <circle cx="50" cy="50" r="39" />
    </svg>
    <ol class="arrangement-grid">
      {
        nodes.map(({ name, glyph, lines, position }) => (
          <li class="node" style={`grid-area: ${gridArea(position)}`}>
            <LineStack lines={[...lines]} />
            <span class="node-label">
              {glyph} {name}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
  <ul class="legend">
    {
      correlations.map(({ trigram, note }) => (
        <li>
          {trigram} — {note}
        </li>
      ))
    }
  </ul>
  <figcaption>
    The Houtian ("Later Heaven") arrangement, grounded in the direction
    correlations the <em>Shuogua zhuan</em> gives each trigram (week 4).
    South is shown at the top, following the same historical convention as
    the Xiantian figure. Its opposite pairs — Li↔Kan, Kun↔Gen, Dui↔Zhen,
    Qian↔Xun — are a different set from the week-5 line-inverse pairs: here,
    "opposite" means opposite in this particular arrangement, not the
    line-inverse relation that holds regardless of arrangement.
  </figcaption>
</figure>

<style>
  .fig-arrangement {
    margin: 1.5rem 0;
    padding: 0 2.5rem;
  }

  .arrangement-frame {
    position: relative;
    width: min(100%, 26rem);
    margin: 2.25rem auto 0.75rem;
  }

  .ring-guide {
    position: absolute;
    inset: 0;
    z-index: 0;
    fill: none;
    stroke: var(--at-divider);
    stroke-width: 0.4;
    opacity: 0.5;
  }

  .arrangement-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    grid-template-areas:
      "se s sw"
      "e . w"
      "ne n nw";
    aspect-ratio: 1;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
  }

  .node-label {
    font-size: 0.72rem;
    text-align: center;
    color: var(--at-text-muted);
    white-space: nowrap;
  }

  .axis-label {
    position: absolute;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--at-text-muted);
    white-space: nowrap;
  }

  .axis-top {
    top: -1.5rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .axis-bottom {
    bottom: -1.5rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .axis-left {
    top: 50%;
    left: -0.35rem;
    transform: translate(-100%, -50%);
  }

  .axis-right {
    top: 50%;
    right: -0.35rem;
    transform: translate(100%, -50%);
  }

  @media (max-width: 26rem) {
    .fig-arrangement {
      padding: 0 1.65rem;
    }

    .node-label {
      font-size: 0.68rem;
    }

    .axis-label {
      font-size: 0.68rem;
    }
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    justify-content: center;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
    color: var(--at-text-muted);
  }

  figcaption {
    font-size: 0.85rem;
    color: var(--at-text-muted);
  }
</style>
