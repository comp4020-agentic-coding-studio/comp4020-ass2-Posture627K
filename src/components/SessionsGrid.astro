---
import { getPublishedCollection } from "astro-course-university/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import { formatCourseDate } from "../lib/dates";
import { phaseForWeek } from "../lib/course-arc";

const sessions = await getPublishedCollection("sessions");
const visible = sessions.sort((a, b) => a.data.week - b.data.week);
---

<CardGrid columns={2}>
  {
    visible.map((session) => {
      const phase = phaseForWeek(session.data.week);
      return (
        <Card headingLevel="h2" title={session.data.title} href={`/sessions/${session.id}/`}>
          <div class="at-card-badges">
            <span class="at-card-badge">Week {session.data.week}</span>
            <span class="at-card-badge">{formatCourseDate(session.data.date)}</span>
            <span class={`at-card-badge phase-badge phase-badge--${phase.key}`}>{phase.label}</span>
          </div>
          {session.data.description && <p>{session.data.description}</p>}
        </Card>
      );
    })
  }
</CardGrid>

<style>
  .phase-badge--framing {
    background: var(--at-tertiary);
    color: var(--at-on-primary);
  }

  .phase-badge--building {
    background: var(--at-primary);
    color: var(--at-on-primary);
  }

  .phase-badge--history {
    background: var(--at-secondary);
    color: var(--at-on-primary);
  }
</style>
